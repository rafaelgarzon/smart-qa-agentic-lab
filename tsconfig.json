{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@types/node", "@playwright/test"],
    "resolveJsonModule": true
  },
  "include": ["pages/**/*", "tests/**/*", "fixtures/**/*", "types/**/*", "utils/**/*"],
  "exclude": ["node_modules"]
}
